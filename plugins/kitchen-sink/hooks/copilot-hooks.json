      {
        "type": "command",
        "bash": "node ./hooks/on-event.mjs copilot sessionStart",
        "powershell": "node ./hooks/on-event.mjs copilot sessionStart",
        "timeoutSec": 10
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "node ./hooks/on-event.mjs copilot sessionEnd",
