{
  "description": "Block force-pushes to main or master",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-force-push.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
