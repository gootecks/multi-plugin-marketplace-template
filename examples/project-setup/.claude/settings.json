{
  "extraKnownMarketplaces": {
    "example-ai-marketplace": {
      "source": {
        "source": "github",
        "repo": "CarterCole/example-ai-marketplace"
      }
    }
  },
  "enabledPlugins": {
    "commit-craft@example-ai-marketplace": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}/.claude/hooks/no-publish.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
